# OVHcloud Storage Root (Mounted 1TB Block Storage volume)
STORAGE_DIR=/mnt/storage

# MongoDB Settings
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secretpassword
MONGO_INITDB_DATABASE=media_db
MONGODB_URL=mongodb://admin:secretpassword@localhost:27017/media_db?authSource=admin

# Mongo Express Web UI Binding & Authentication (Port 8081)
# Keep 127.0.0.1 for SSH tunnel access, or switch to 0.0.0.0 for direct public web access
MONGO_EXPRESS_BIND=127.0.0.1
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=expresspassword

# Authentication & JWT Security
JWT_SECRET_KEY=drive-connector-super-secret-key-2026-prod
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@Drive2026!

# Google Drive API Settings
# Path to your Google Cloud Service Account JSON file or OAuth credentials
GOOGLE_CREDENTIALS_FILE=/mnt/storage/config/credentials.json
GOOGLE_TOKEN_FILE=/mnt/storage/config/token.json
# Optional: Target specific Google Drive folder ID to sync; leave empty for root/all
GOOGLE_DRIVE_FOLDER_ID=

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CPU Core Governance for Video Workers & Web Serving
# Number of CPU cores reserved for FastAPI web serving, MongoDB, and system tasks (default: 1)
# Example: On an 8-core server, 1 core is spared for web handling and 7 cores are dedicated to video processing
RESERVED_CPU_CORES=1
# Optional: explicitly set worker threads for FFmpeg/Whisper (leave blank to auto-calculate: total_cores - RESERVED_CPU_CORES)
FFMPEG_THREADS=

# Memory Governance & 32GB RAM Cloud Pipeline Distribution
# 10% strictly reserved for host OS / Web Server (~3.2 GB), 90% (~28.8 GB) distributed across Cloud Pipeline
TOTAL_RAM_GB=32
RESERVED_RAM_RATIO=0.10
CLOUD_PIPELINE_RAM_RATIO=0.90
# High concurrency video transcoding & WebVTT sprite generation (up to 4 parallel workers)
MAX_CONCURRENT_FFMPEG=4

# JDownloader 2 Web Desktop (Port 5800)
# Supports 4,000+ hosters (Gofile, 1Fichier, Mega, Rapidgator, etc.)
# Downloads automatically save to /mnt/storage/videos and can be indexed with "Scan Storage"
# Set to 0.0.0.0 for public access or keep 127.0.0.1 for SSH tunnel (ssh -L 5800:127.0.0.1:5800 ubuntu@<SERVER_IP>)
JDOWNLOADER_BIND=127.0.0.1
JDOWNLOADER_PORT=5800
JDOWNLOADER_PASSWORD=admin123
