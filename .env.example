# Copy to .env and set unique credentials, or run ./setup.sh to generate them.
# Existing MongoDB volumes continue using the credentials with which they were initialized.
STORAGE_DIR=/mnt/storage
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=media_db
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
JDOWNLOADER_PASSWORD=
GOOGLE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
RESERVED_CPU_CORES=1
FFMPEG_THREADS=
MAX_CONCURRENT_FFMPEG=2
# Off by default: URL engines may follow redirects and access private destinations.
# Do not enable until outgoing network isolation has been configured and verified.
ENABLE_EXTERNAL_URLS=false
